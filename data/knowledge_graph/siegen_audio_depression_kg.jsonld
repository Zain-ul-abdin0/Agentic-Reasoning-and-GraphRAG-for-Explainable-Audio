      "type": "Symptom",
      "name": "Fatigue or Low Energy",
      "source": "PHQ-8 tired or little energy item"
    },
    {
      "id": "symptom:concentration_difficulty",
      "type": "Symptom",
      "name": "Difficulty Concentrating",
      "source": "PHQ-8 concentration item"
    },
    {
      "id": "screening:phq8_depression_severity",
      "type": "ScreeningConstruct",
      "name": "PHQ-8 Depression Severity",
      "source": "PHQ-8 screening construct"
    },
    {
      "id": "risk:depression_screening_risk",
      "type": "Risk",
      "name": "Depression Screening Risk",
      "description": "Non-diagnostic signal that depression-relevant speech patterns may be present."
    },
    {
      "id": "intervention:clinical_review",
      "type": "Intervention",
      "name": "Clinical Review",
      "description": "Review the acoustic explanation alongside interview, questionnaire, and contextual information."
    },
    {
      "id": "intervention:phq8_followup",
      "type": "Intervention",
      "name": "PHQ-8 Follow-up",
      "description": "Use PHQ-8 or clinician-administered assessment as structured follow-up rather than treating audio as a diagnosis."
    },
    {
      "id": "intervention:supportive_followup",
      "type": "Intervention",
      "name": "Supportive Follow-up",
      "description": "Encourage supportive clinical discussion when speech patterns suggest distress, fatigue, or slowed expression."
    }
  ],
